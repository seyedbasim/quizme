# Copy to .env for LOCAL development only. In Azure these come from Key Vault via
# Managed Identity, or from App settings (AD-17). Never commit the real .env.

# --- Postgres (prefer Entra token auth in Azure; password only for local) ---
DATABASE_URL=postgresql+psycopg://quizme:quizme@localhost:5432/quizme

# --- Azure resources ---
AZURE_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_QUEUE_ACCOUNT_URL=https://<account>.queue.core.windows.net
AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net

# --- Foundry / OpenAI-compatible endpoint ---
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=            # local only; in Azure use Managed Identity / DefaultAzureCredential

# --- Azure AI Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# --- Telegram (Delivery adapter) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=         # X-Telegram-Bot-Api-Secret-Token value
TELEGRAM_ALLOWED_CHAT_ID=       # the single authorised chat id (AD-10)

# --- Web auth (AD-10) ---
# Easy Auth injects X-MS-CLIENT-PRINCIPAL; this is the allowlisted oid / email.
WEB_ALLOWED_PRINCIPAL=

# --- misc ---
QUIZME_CONFIG=config.toml
